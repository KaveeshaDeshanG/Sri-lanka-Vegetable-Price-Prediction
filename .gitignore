# Python
__pycache__/
*.pyc
.venv/
.venv312/
venv/
*.egg-info/
.pytest_cache/

# Private settings and credentials (never commit)
.env
.env.*

# Local tool state and archives
.claude/
*.rar

# Data & models: the real datasets (data/raw), trained models (models/*.joblib) and evaluation
# results (reports/metrics, reports/figures) ARE committed, so a fresh clone runs the app without
# rebuilding from the 2 GB PDF archive. Every file is far below GitHub's 100 MB limit.
# Only the derived processed dataset is regenerated locally (scripts/train.py).
data/processed/*
!data/processed/.gitkeep
# Sandbox models trained from the Predict page are local experiments only.
models/demo/*
!models/demo/.gitkeep

# Daily update output (scripts/run_daily_update.bat)
logs/

# Editors / OS
.vscode/
.vs/
.idea/
.DS_Store

# Streamlit
.streamlit/secrets.toml
